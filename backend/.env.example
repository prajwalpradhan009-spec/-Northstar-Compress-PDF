# ==========================================
# SERVER
# ==========================================
NODE_ENV=development
PORT=4000

# ==========================================
# FRONTEND / CORS
# Comma-separated origins. FRONTEND_URL is added to the list automatically.
# Local dev: the Vite server. Production: your Render URL.
# ==========================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# ==========================================
# MONGODB
# ==========================================
MONGODB_URI=your_mongodb_connection_string_here

# ==========================================
# AUTHENTICATION
# Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================================
JWT_SECRET=your_jwt_secret_here

# ==========================================
# PDF PROCESSING LIMITS
# ==========================================
PDF_MAX_UPLOAD_MB=60
PDF_MAX_FILES=20
PDF_MAX_PAGES=500
OCR_MAX_PAGES=30
OCR_LANGUAGE=eng

# ==========================================
# GOOGLE GEMINI
# Backend only. Never expose this to the frontend and never
# create a VITE_GEMINI_API_KEY variable.
# Get a key at https://aistudio.google.com/apikey
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_DOCUMENT_CHARS=250000

# ==========================================
# EMAIL (password reset codes)
# Use an App Password, not your normal account password.
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=Northstar <your-email@gmail.com>

# ==========================================
# RENDER PRODUCTION EXAMPLE
# Set these in the Render dashboard, not in this file.
#   NODE_ENV=production
#   PORT=10000
#   FRONTEND_URL=https://northstar-compress-pdf.onrender.com
#   ALLOWED_ORIGINS=https://northstar-compress-pdf.onrender.com
# Render injects PORT automatically for Web Services.
# ==========================================
