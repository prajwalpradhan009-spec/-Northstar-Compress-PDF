# Backend API base URL.
#
# Leave EMPTY when the frontend and backend are served by the same Render
# service (the Northstar setup). Requests then use relative /api/... paths,
# which is what production should do.
#
# Set it only when the backend is deployed separately, e.g.
#   VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
